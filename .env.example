# ── LLM 프로바이더 설정 ───────────────────────────────────────
# 사용할 프로바이더: groq | ollama | anthropic
LLM_PROVIDER=groq
# 모델명 (프로바이더에 맞게 변경)
LLM_MODEL=llama-3.3-70b-versatile

# ── API 키 (사용하는 프로바이더 것만 입력) ────────────────────
# Groq (무료) : https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Anthropic (유료) : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (로컬): API 키 불필요, 아래 모델만 지정
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# ── Django 설정 ───────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
